# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. This file only documents the NAMES of settings, with safe fake values.
# Keep comments on their own lines: some tools treat "VALUE  # comment" as part of the value.

# --- App ---
APP_NAME=ai-project-template
# One of: local | ci | staging | prod
APP_ENV=local
LOG_LEVEL=INFO

# --- LLM ---
# One of: fake (add real providers in src/app/llm/)
LLM_PROVIDER=fake
LLM_MODEL=fake-model
LLM_TIMEOUT_SECONDS=30
LLM_API_KEY=replace-me

# --- Postgres container (read by docker compose to create the database) ---
POSTGRES_USER=sportsops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sportsops

# --- Dependencies (read by the app) ---
# These use localhost, for `uv run uvicorn ...` on your machine.
# Inside docker compose, the app gets its own values pointing at the service names
# (postgres, redis), so you never need to edit this file to switch.
DATABASE_URL=postgresql://sportsops:change-me-local-only@localhost:5432/sportsops
REDIS_URL=redis://localhost:6379/0
# Max seconds for one whole readiness check (connect + query)
DEPENDENCY_CHECK_TIMEOUT_SECONDS=1.0
