# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. This file only documents the NAMES of settings, with safe fake values.
# Keep comments on their own lines: some tools treat "VALUE  # comment" as part of the value.

# --- App ---
APP_NAME=ai-project-template
# One of: local | ci | staging | prod
APP_ENV=local
LOG_LEVEL=INFO

# --- LLM ---
# One of: fake (add real providers in src/app/llm/)
LLM_PROVIDER=fake
LLM_MODEL=fake-model
LLM_TIMEOUT_SECONDS=30
LLM_API_KEY=replace-me
